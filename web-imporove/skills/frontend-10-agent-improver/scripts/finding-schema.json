{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frontend Improvement Finding",
  "description": "Schema for findings produced by the 10-agent frontend improvement system",
  "type": "object",
  "required": ["id", "agent", "severity", "title", "evidence", "impact", "effort", "fix_sketch", "metric", "files_touched", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^F-[A-Z]{2}-[0-9]{4}$", "description": "Unique finding ID, e.g. F-PF-0001" },
    "agent": { "type": "string", "enum": ["A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "A9", "A10"], "description": "Agent that produced the finding" },
    "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"], "description": "Severity level: P0=blocking, P1=critical, P2=major, P3=minor" },
    "title": { "type": "string", "maxLength": 120, "description": "Short human-readable title" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "line", "snippet", "measurement"],
        "properties": {
          "file": { "type": "string", "description": "File path relative to project root" },
          "line": { "type": "integer", "minimum": 1, "description": "Line number" },
          "snippet": { "type": "string", "description": "Relevant code snippet" },
          "measurement": { "type": "string", "description": "Quantified measurement" }
        }
      }
    },
    "impact": { "type": "integer", "minimum": 1, "maximum": 5, "description": "User or business impact (1=low, 5=critical)" },
    "effort": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Fix effort (1=trivial, 3=medium, 5=large)" },
    "fix_sketch": { "type": "string", "description": "Brief description of the fix approach" },
    "metric": {
      "type": "object",
      "required": ["name", "before", "after_null_ok", "unit"],
      "properties": {
        "name": { "type": "string", "description": "Metric name, e.g. bundle_kb" },
        "before": { "type": "number", "description": "Value before fix" },
        "after_null_ok": { "type": ["number", "null"], "description": "Value after fix (null until applied)" },
        "unit": { "type": "string", "description": "Unit of measurement" }
      }
    },
    "files_touched": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Files that would be modified by the fix"
    },
    "status": {
      "type": "string",
      "enum": ["open", "queued", "in_progress", "fixed", "reverted", "blocked_backend"],
      "description": "Current status of the finding"
    }
  },
  "additionalProperties": false
}
