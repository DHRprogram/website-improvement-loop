# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=agent_team
POSTGRES_PORT=5432
AGENT_TEAM_POSTGRES_DSN=postgresql://postgres:changeme-in-production@localhost:5432/agent_team

# Redis
REDIS_PORT=6379
AGENT_TEAM_REDIS_URL=redis://localhost:6379/0

# Gateway Service
GATEWAY_PORT=8000
AGENT_TEAM_GATEWAY_URL=http://localhost:8000

# Control Room Service
CONTROL_ROOM_PORT=8001

# Agent Runtime Services
AGENT_RUNTIME_PORT=8002

# Memory Service
MEMORY_PORT=8003

# Sandbox Service
SANDBOX_PORT=8090
SANDBOX_MAX_MEMORY=1g
SANDBOX_MAX_CPU=0.5
AGENT_TEAM_SANDBOX_URL=http://localhost:8090

# Git Bridge Service
GIT_BRIDGE_PORT=8091
AGENT_TEAM_GITHUB_TOKEN=ghp_example_token_here
AGENT_TEAM_GITHUB_REPO=owner/repo-name
AGENT_TEAM_GITHUB_BASE_BRANCH=main

# OpenTelemetry
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
AGENT_TEAM_OTEL_ENDPOINT=http://localhost:4317

# LLM Provider
AGENT_TEAM_OPENROUTER_API_KEY=sk-or-v1-example-key-here
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-6

# Budget Configuration
BUDGET_CAP_USD=50.00
BUDGET_WARNING_THRESHOLD=0.75
BUDGET_CRITICAL_THRESHOLD=0.90

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=false
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
