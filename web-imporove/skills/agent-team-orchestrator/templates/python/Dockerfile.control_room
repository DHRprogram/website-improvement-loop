FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir django jinja2 gunicorn
COPY shared/ shared/
COPY services/control_room/ services/control_room/
COPY services/orchestrator/models.py orchestrator/models.py
EXPOSE 8001
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8001", "--workers", "2"]
