FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir httpx pydantic fastapi opentelemetry-api opentelemetry-instrumentation-fastapi prometheus-client docker-python
COPY shared/ shared/
COPY services/agent_runtime/ services/agent_runtime/
EXPOSE 8003
CMD ["uvicorn", "services.agent_runtime.main:app", "--host", "0.0.0.0", "--port", "8003"]
