FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir celery redis django psycopg-binary pgvector opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp-proto-grpc
COPY shared/ shared/
COPY services/orchestrator/ services/orchestrator/
COPY orchestrator/models.py orchestrator/models.py
COPY orchestrator/celery_app.py orchestrator/celery_app.py
EXPOSE 8002
CMD ["celery", "-A", "orchestrator", "worker", "--loglevel=info", "--concurrency=4"]
