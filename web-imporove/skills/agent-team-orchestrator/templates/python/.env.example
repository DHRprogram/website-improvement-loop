# OpenRouter configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODEL=qwen/qwen2.5-72b:free

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@postgres:5432/agent_platform

# Redis
REDIS_URL=redis://redis:6379/0

# GitHub integration
GITHUB_TOKEN=your-github-personal-access-token-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Django secret key
DJANGO_SECRET_KEY=django-secret-key-change-me-in-production

# OpenTelemetry
OTEL_SERVICE_NAME=agent-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_ENABLED=true

# Sandbox Docker access
SANDBOX_DOCKER_HOST=http://host.docker.internal:2375
SANDBOX_DEFAULT_TIMEOUT=300

# Agent runtime
AGENT_RUNTIME_REPLICAS=3
BUDGET_CAP_USD=100
PER_AGENT_BUDGET_USD=20

# Rate limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Pgvector
PGVECTOR_EXTENSION=vector

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
