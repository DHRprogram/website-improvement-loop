FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir djangorestframework django httpx prometheus-client python-dotenv fastapi uvicorn
COPY shared/ shared/
COPY services/gateway/ services/gateway/
EXPOSE 8000
CMD ["uvicorn", "services.gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
